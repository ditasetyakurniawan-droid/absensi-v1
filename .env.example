# Copy this file to .env. Never commit the real .env.

MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=db_absensi
SERVER_PORT=8080

# Vite dev server only. Production is same-origin through Nginx/Ingress.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Used only when table admins is empty. Remove these after the first admin exists.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_10_CHARS
ADMIN_BOOTSTRAP_FULL_NAME=Administrator ZABISA
